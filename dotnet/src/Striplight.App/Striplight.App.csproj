<Project Sdk="Microsoft.NET.Sdk">
  <!-- Desktop shell: a WPF window hosting Microsoft Edge WebView2. The UI itself is
       HTML/CSS/vanilla JS in wwwroot/; all imaging and file work runs in Striplight.Core. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Striplight.App</RootNamespace>
    <AssemblyName>StriplightPRO</AssemblyName>
    <ApplicationIcon>..\..\..\assets\striplight_app_icon_main.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Striplight.Core\Striplight.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Front end served to WebView2 from https://app.striplight/ -->
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- libjpeg-turbo 3.x runtime (TurboJPEG API), x64 -->
    <None Include="..\..\native\win-x64\libturbojpeg.dll" Link="libturbojpeg.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\native\third-party\**\*" LinkBase="third-party" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="..\..\..\assets\striplight_app_icon_main.ico" Link="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Source for the vendored editor bundle; not shipped. -->
    <None Remove="web-vendor\**" />
    <Compile Remove="web-vendor\**" />
  </ItemGroup>
</Project>
