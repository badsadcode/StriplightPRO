<Project>
  <!-- Shared settings for every project in the C# edition of Striplight. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Company>Bad Ideas Works</Company>
    <Product>Striplight PRO</Product>
    <Version>0.2.0</Version>
    <!-- Lets the WPF project build (not run) on Linux/macOS build agents. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
